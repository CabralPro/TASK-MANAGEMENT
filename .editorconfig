root = true

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = when_multiline:suggestion
csharp_style_prefer_primary_constructors = true:suggestion

# Disable Roslynator (RCS*) — bundled with C# Dev Kit
dotnet_analyzer_diagnostic.category-roslynator.severity = none

# Disable IDE style diagnostics (IDE0008, IDE0022, …) from C# Dev Kit
dotnet_analyzer_diagnostic.category-Style.severity = none
dotnet_diagnostic.IDE0008.severity = none
dotnet_diagnostic.IDE0022.severity = none
dotnet_diagnostic.IDE0161.severity = none

# Disable C# Dev Tools extras (CDT*)
dotnet_diagnostic.CDT1003.severity = none

# Keep useful quality rules (MSBuild / CA only)
dotnet_diagnostic.CA1816.severity = warning
dotnet_diagnostic.CA2211.severity = warning
